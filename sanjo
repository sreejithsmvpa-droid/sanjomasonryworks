<!DOCTYPE html>
<html lang="ml">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>SANJO Masonry Works | തലമുറകളുടെ വിശ്വാസം | Vennala, Cochin</title>
<meta name="description" content="SANJO Masonry Works - മൂന്ന് തലമുറകളായി തുടരുന്ന പരമ്പരാഗത മേസൺ പണി. കോൺട്രാക്ട്, നിർമ്മാണം, നവീകരണം, അറ്റകുറ്റപ്പണി. Vennala, Cochin. GST Registered.">
<meta property="og:title" content="SANJO Masonry Works — Trusted To Deliver On Time">
<meta property="og:description" content="3 തലമുറകളായി തുടരുന്ന പരമ്പരാഗത തൊഴിൽ. Contracting, Masonry, Renovation & New Construction in Vennala, Cochin.">
<meta property="og:type" content="website">
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Playfair+Display:ital,wght@1,500;1,600&family=Noto+Serif+Malayalam:wght@400;500;600;700&family=Noto+Sans+Malayalam:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --charcoal:#201A16;
    --charcoal-2:#2A2320;
    --charcoal-3:#332B26;
    --cream:#F6F0E4;
    --cream-2:#EFE6D4;
    --sand:#D9C4A0;
    --brick:#A5431F;
    --brick-dark:#7E3115;
    --brick-light:#C15A31;
    --white:#FFFFFF;
    --ink:#2A2119;
    --ink-soft:#5C5045;
    --gold:#B08948;
    --line:rgba(42,33,25,0.14);
    --line-light:rgba(255,255,255,0.16);
    --shadow-soft: 0 18px 40px rgba(32,26,22,0.16);
    --radius-s: 4px;
    --radius-m: 6px;
  }

  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Noto Sans Malayalam','Inter',sans-serif;
    color:var(--ink);
    background:var(--cream);
    line-height:1.65;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }
  img{max-width:100%; display:block;}
  a{color:inherit; text-decoration:none;}
  ul{list-style:none;}
  button{font-family:inherit; cursor:pointer;}

  .ml-serif{font-family:'Noto Serif Malayalam', serif;}
  .display{font-family:'Fraunces', serif;}

  h1,h2,h3,h4{font-family:'Noto Serif Malayalam', serif; font-weight:600; color:var(--ink); line-height:1.32;}

  .wrap{max-width:1220px; margin:0 auto; padding:0 28px;}
  @media (max-width:640px){ .wrap{padding:0 20px;} }

  .eyebrow{
    font-family:'Fraunces', serif;
    font-style:italic;
    font-weight:500;
    font-size:15px;
    color:var(--brick);
    letter-spacing:0.01em;
    margin-bottom:14px;
    display:inline-block;
  }

  /* ===== NAV ===== */
  header.site-nav{
    position:fixed; top:0; left:0; right:0; z-index:100;
    padding:20px 0;
    transition:background .4s ease, padding .4s ease, box-shadow .4s ease;
  }
  header.site-nav .wrap{display:flex; align-items:center; justify-content:space-between;}
  header.site-nav.scrolled{
    background:rgba(32,26,22,0.94);
    backdrop-filter:blur(8px);
    padding:12px 0;
    box-shadow:0 6px 24px rgba(0,0,0,0.18);
  }
  .brand{display:flex; align-items:center; gap:12px;}
  .brand img{height:40px; width:auto; filter:brightness(0) invert(1);}
  .brand-text{color:var(--white); line-height:1.1;}
  .brand-text .bname{font-family:'Fraunces',serif; font-weight:700; font-size:20px; letter-spacing:0.03em;}
  .brand-text .bsub{font-family:'Noto Serif Malayalam',serif; font-size:11px; color:var(--sand); font-weight:400;}

  nav.primary-nav{display:flex; align-items:center; gap:34px;}
  nav.primary-nav a{
    color:var(--white); font-size:15.5px; font-weight:500; font-family:'Noto Sans Malayalam',sans-serif;
    position:relative; padding-bottom:4px;
  }
  nav.primary-nav a::after{
    content:''; position:absolute; left:0; bottom:0; width:0; height:1.5px; background:var(--brick-light);
    transition:width .3s ease;
  }
  nav.primary-nav a:hover::after{width:100%;}

  .nav-actions{display:flex; align-items:center; gap:16px;}
  .btn-wa-nav{
    display:flex; align-items:center; gap:8px;
    background:var(--brick); color:var(--white);
    padding:10px 20px; border-radius:2px; font-size:14.5px; font-weight:600;
    border:1px solid var(--brick);
    transition:background .3s ease, transform .2s ease;
  }
  .btn-wa-nav:hover{background:var(--brick-light); transform:translateY(-1px);}
  .social-icon{
    display:flex; align-items:center; justify-content:center;
    width:38px; height:38px; border-radius:50%; color:var(--white);
    border:1px solid rgba(255,255,255,0.35); transition:all .25s ease;
  }
  .social-icon:hover{background:var(--white); color:var(--charcoal); border-color:var(--white);}
  .mobile-fb{
    display:flex !important; flex-direction:row; align-items:center; gap:10px;
    width:auto; height:auto; border-radius:2px; padding:12px 18px; margin-top:14px;
    font-family:'Noto Sans Malayalam',sans-serif; font-size:15px; font-weight:600;
    border:1px solid var(--line-light); color:var(--cream) !important;
  }

  .hamburger{display:none; flex-direction:column; gap:5px; background:none; border:none; padding:6px; z-index:110;}
  .hamburger span{width:26px; height:2px; background:var(--white); display:block; transition:all .3s ease;}
  .hamburger.active span:nth-child(1){transform:translateY(7px) rotate(45deg);}
  .hamburger.active span:nth-child(2){opacity:0;}
  .hamburger.active span:nth-child(3){transform:translateY(-7px) rotate(-45deg);}

  .mobile-menu{
    position:fixed; inset:0; background:var(--charcoal); z-index:105;
    display:flex; flex-direction:column; align-items:flex-start; justify-content:center;
    padding:40px; gap:6px;
    transform:translateX(100%); transition:transform .45s cubic-bezier(.7,0,.2,1);
  }
  .mobile-menu.open{transform:translateX(0);}
  .mobile-menu a{
    color:var(--cream); font-family:'Noto Serif Malayalam',serif; font-size:30px; font-weight:600;
    padding:14px 0; border-bottom:1px solid var(--line-light); width:100%;
  }
  .mobile-menu .btn-wa-nav{margin-top:24px;}

  /* ===== HERO ===== */
  .hero{
    position:relative; min-height:100svh; display:flex; align-items:flex-start;
    background:var(--charcoal);
    overflow:hidden;
  }
  .hero-img{
    position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 65%;
    opacity:0.92;
  }
  .hero-overlay{
    position:absolute; inset:0;
    background:linear-gradient(180deg, rgba(20,16,13,0.55) 0%, rgba(20,16,13,0.35) 32%, rgba(20,16,13,0.55) 68%, rgba(16,13,10,0.94) 100%);
  }
  .hero-content{position:relative; z-index:2; width:100%; padding-top:148px; padding-bottom:90px;}
  @media (max-width:640px){ .hero-content{padding-top:118px;} }
  .hero-content .eyebrow{color:var(--sand); font-size:19px;}
  .hero-logo{
    height:56px; width:auto; margin-bottom:22px;
    filter:brightness(0) invert(1); opacity:0.95;
  }
  @media (max-width:640px){ .hero-logo{height:44px; margin-bottom:16px;} }
  .hero-title{
    color:var(--white);
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:clamp(64px, 11vw, 132px);
    line-height:0.98;
    letter-spacing:-0.01em;
  }
  .hero-title small{
    display:block;
    font-family:'Noto Serif Malayalam', serif;
    font-size:clamp(28px, 4vw, 44px);
    font-weight:500;
    color:var(--sand);
    margin-top:14px;
    letter-spacing:0;
  }
  .hero-taglines{margin-top:34px; max-width:600px;}
  .hero-taglines p{
    color:var(--cream-2); font-size:clamp(16px, 1.6vw, 19px); font-style:italic;
    font-family:'Playfair Display',serif; font-weight:500;
    margin-bottom:10px; opacity:0.95; letter-spacing:0.04em;
    text-transform:uppercase;
  }
  .hero-ctas{display:flex; gap:16px; margin-top:46px; flex-wrap:wrap;}
  .btn{
    display:inline-flex; align-items:center; gap:10px;
    padding:18px 34px; font-size:16.5px; font-weight:600; border-radius:2px;
    transition:transform .25s ease, background .25s ease, color .25s ease, border-color .25s ease;
    border:1px solid transparent;
    font-family:'Noto Sans Malayalam',sans-serif;
  }
  .btn-primary{background:var(--brick); color:var(--white);}
  .btn-primary:hover{background:var(--brick-light); transform:translateY(-2px);}
  .btn-outline{border-color:rgba(255,255,255,0.5); color:var(--white);}
  .btn-outline:hover{border-color:var(--white); background:rgba(255,255,255,0.08); transform:translateY(-2px);}
  .btn-dark{background:var(--charcoal); color:var(--cream);}
  .btn-dark:hover{background:var(--charcoal-2); transform:translateY(-2px);}

  .hero-scroll-cue{
    position:absolute; bottom:28px; left:28px; z-index:2; color:var(--sand); font-size:12.5px;
    display:flex; align-items:center; gap:10px; letter-spacing:0.04em;
  }
  .hero-scroll-cue .line{width:32px; height:1px; background:var(--sand); display:inline-block;}

  /* brick coursing divider */
  .brick-rule{
    display:flex; height:8px; width:100%;
  }
  .brick-rule span{flex:1; border-right:2px solid var(--cream);}
  .brick-rule.dark span{background:var(--brick-dark); border-right-color:var(--charcoal);}
  .brick-rule.light span{background:var(--sand); border-right-color:var(--cream);}

  /* ===== SECTION GENERIC ===== */
  section{padding:110px 0;}
  @media (max-width:800px){ section{padding:74px 0;} }
  .section-head{max-width:640px; margin-bottom:56px;}
  .section-head h2{font-size:clamp(28px,3.6vw,42px);}
  .section-head p{color:var(--ink-soft); font-size:17px; margin-top:16px; max-width:60ch;}

  /* ===== TRUST/INTRO ===== */
  .intro{background:var(--cream);}
  .intro-grid{display:grid; grid-template-columns:1.1fr 0.9fr; gap:70px; align-items:center;}
  @media (max-width:880px){ .intro-grid{grid-template-columns:1fr; gap:40px;} }
  .intro-text h2{font-size:clamp(26px,3.4vw,38px); max-width:16ch;}
  .intro-text p{margin-top:22px; color:var(--ink-soft); font-size:16.5px; max-width:56ch;}
  .intro-list{margin-top:28px; display:flex; flex-direction:column; gap:12px;}
  .intro-list li{display:flex; align-items:baseline; gap:12px; font-size:16px; color:var(--ink);}
  .intro-list li::before{content:''; width:7px; height:7px; background:var(--brick); flex:0 0 auto; transform:translateY(-2px); border-radius:1px;}
  .intro-img{position:relative;}
  .intro-img img{width:100%; height:460px; object-fit:cover; border-radius:2px;}
  .intro-img::before{
    content:''; position:absolute; top:-18px; left:-18px; width:120px; height:120px;
    border-top:3px solid var(--brick); border-left:3px solid var(--brick); z-index:1;
  }

  /* ===== HERITAGE / WALL ===== */
  .heritage{background:var(--charcoal); color:var(--cream); position:relative; overflow:hidden;}
  .heritage::before{
    content:''; position:absolute; top:0; left:0; right:0; height:8px;
  }
  .heritage-grid{display:grid; grid-template-columns:0.95fr 1.05fr; gap:70px; align-items:center;}
  @media (max-width:900px){ .heritage-grid{grid-template-columns:1fr; gap:50px;} }
  .heritage .section-head{max-width:520px;}
  .heritage .section-head h2{color:var(--white); font-size:clamp(26px,3.6vw,40px);}
  .heritage-copy p{color:var(--sand); font-size:16.5px; margin-bottom:16px; max-width:52ch;}
  .heritage-copy .quote{
    font-family:'Fraunces',serif; font-style:italic; font-size:19px; color:var(--cream-2);
    border-left:2px solid var(--brick); padding-left:20px; margin-top:26px;
  }

  .wall{display:flex; flex-direction:column-reverse; gap:6px; max-width:460px;}
  .course{
    display:flex; align-items:center; gap:20px;
    background:linear-gradient(180deg, var(--brick-light), var(--brick));
    padding:22px 26px;
    border-bottom:5px solid var(--brick-dark);
    box-shadow:0 10px 20px rgba(0,0,0,0.25);
    opacity:0; transform:translateY(24px);
    transition:opacity .7s ease, transform .7s ease;
  }
  .course.show{opacity:1; transform:translateY(0);}
  .course:nth-child(1){transition-delay:0s;}
  .course:nth-child(2){transition-delay:.18s;}
  .course:nth-child(3){transition-delay:.36s;}
  .course .mortar-line{display:none;}
  .course-num{
    font-family:'Fraunces',serif; font-weight:600; font-size:26px; color:rgba(255,255,255,0.55);
    flex:0 0 auto; width:34px;
  }
  .course-info{flex:1;}
  .course-info .gen-name{font-family:'Noto Serif Malayalam',serif; font-size:21px; font-weight:600; color:var(--white);}
  .course-info .gen-role{font-size:13.5px; color:rgba(255,255,255,0.8); margin-top:3px;}
  .wall-caption{margin-top:18px; font-size:13px; color:var(--sand); font-style:italic; font-family:'Fraunces',serif;}

  /* ===== SERVICES ===== */
  .services{background:var(--cream-2);}
  .services-grid{
    display:grid; grid-template-columns:repeat(3, 1fr); gap:2px; background:var(--line);
    border:1px solid var(--line);
  }
  @media (max-width:900px){ .services-grid{grid-template-columns:repeat(2,1fr);} }
  @media (max-width:560px){ .services-grid{grid-template-columns:1fr;} }
  .service-card{
    background:var(--cream); padding:40px 32px; position:relative; overflow:hidden;
    transition:background .3s ease;
  }
  .service-card:hover{background:var(--white);}
  .service-icon{width:46px; height:46px; margin-bottom:24px; color:var(--brick);}
  .service-card h3{font-size:20px; margin-bottom:12px;}
  .service-card p{color:var(--ink-soft); font-size:15px; max-width:32ch;}
  .service-card .num{
    position:absolute; top:24px; right:28px; font-family:'Fraunces',serif; font-size:14px; color:var(--sand);
  }
  .service-card::after{
    content:''; position:absolute; left:0; bottom:0; height:3px; width:0; background:var(--brick);
    transition:width .35s ease;
  }
  .service-card:hover::after{width:100%;}

  /* ===== WHY SANJO ===== */
  .why{
    position:relative; color:var(--white); background:var(--charcoal-2);
  }
  .why-bg{position:absolute; inset:0; object-fit:cover; opacity:0.22;}
  .why-overlay{position:absolute; inset:0; background:linear-gradient(180deg, rgba(32,26,22,0.9), rgba(32,26,22,0.97));}
  .why-inner{position:relative; z-index:1;}
  .why .section-head h2{color:var(--white);}
  .why .section-head p{color:var(--sand);}
  .stats-row{display:flex; gap:70px; flex-wrap:wrap; margin-bottom:60px;}
  .stat .num{font-family:'Fraunces',serif; font-size:clamp(48px,6vw,74px); font-weight:600; color:var(--brick-light); line-height:1;}
  .stat.word .num{font-size:clamp(30px,3.6vw,42px); letter-spacing:0.02em;}
  .stat .lbl{font-size:14.5px; color:var(--sand); margin-top:8px;}
  .why-points{display:grid; grid-template-columns:1fr 1fr; gap:20px 50px;}
  @media (max-width:700px){ .why-points{grid-template-columns:1fr;} }
  .why-points li{
    display:flex; gap:14px; align-items:flex-start; font-size:16px; color:var(--cream-2);
    padding-bottom:18px; border-bottom:1px solid rgba(255,255,255,0.1);
  }
  .why-points li svg{flex:0 0 auto; margin-top:3px; width:18px; height:18px; color:var(--brick-light);}

  /* ===== PROPRIETOR ===== */
  .proprietor{background:var(--cream);}
  .prop-grid{display:grid; grid-template-columns:0.62fr 1.38fr; gap:70px; align-items:center;}
  @media (max-width:860px){ .prop-grid{grid-template-columns:1fr; gap:60px;} }
  .prop-photo{position:relative; max-width:250px;}
  .prop-photo .frame{
    position:absolute; top:16px; left:16px; right:-16px; bottom:-16px;
    border:2px solid var(--brick); z-index:0;
  }
  .prop-photo img{position:relative; z-index:1; width:100%; max-width:250px; height:auto; object-fit:cover; box-shadow:var(--shadow-soft);}
  .prop-photo-2{
    position:absolute; z-index:3; right:-52px; bottom:-46px; width:125px;
  }
  .prop-photo-2 img{
    width:100%; height:150px; object-fit:cover; border:5px solid var(--cream); box-shadow:0 14px 28px rgba(32,26,22,0.28);
  }
  @media (max-width:860px){ .prop-photo-2{right:auto; left:190px;} }
  @media (max-width:480px){ .prop-photo{max-width:210px;} .prop-photo img{max-width:210px;} .prop-photo-2{left:150px; width:100px;} .prop-photo-2 img{height:120px;} }
  .prop-text .eyebrow{margin-bottom:6px;}
  .prop-text h3{font-size:30px;}
  .prop-text .en-name{font-family:'Fraunces',serif; letter-spacing:0.04em; font-size:14px; color:var(--ink-soft); margin-top:4px;}
  .prop-text .role{color:var(--brick); font-size:14.5px; font-weight:600; margin-top:10px;}
  .prop-text .addr{margin-top:16px; font-size:15px; color:var(--ink-soft); line-height:1.7;}
  .prop-text p.bio{margin-top:22px; font-size:16.5px; color:var(--ink); max-width:56ch;}
  .prop-text .sign{margin-top:24px; font-family:'Fraunces',serif; font-style:italic; font-size:19px; color:var(--brick-dark);}

  /* ===== GALLERY ===== */
  .gallery{background:var(--cream-2);}
  .filter-row{display:flex; gap:10px; flex-wrap:wrap; margin-bottom:40px;}
  .filter-btn{
    padding:9px 20px; border:1px solid var(--line); background:transparent; font-size:14.5px;
    color:var(--ink-soft); border-radius:2px; transition:all .25s ease; font-family:'Noto Sans Malayalam',sans-serif;
  }
  .filter-btn.active, .filter-btn:hover{background:var(--charcoal); color:var(--white); border-color:var(--charcoal);}
  .gallery-grid{
    display:grid; grid-template-columns:repeat(4, 1fr); grid-auto-rows:220px; gap:10px;
  }
  @media (max-width:900px){ .gallery-grid{grid-template-columns:repeat(2,1fr); grid-auto-rows:180px;} }
  @media (max-width:520px){ .gallery-grid{grid-template-columns:1fr; grid-auto-rows:260px;} }
  .g-item{position:relative; overflow:hidden; cursor:pointer;}
  .g-item.wide{grid-column:span 2;}
  .g-item.tall{grid-row:span 2;}
  @media (max-width:520px){ .g-item.wide{grid-column:span 1;} .g-item.tall{grid-row:span 1;} }
  .g-item img{width:100%; height:100%; object-fit:cover; transition:transform .5s ease;}
  .g-item:hover img{transform:scale(1.06);}
  .g-item .g-cap{
    position:absolute; left:0; right:0; bottom:0; padding:16px 18px;
    background:linear-gradient(0deg, rgba(20,16,13,0.85), transparent);
    color:var(--white); font-size:14px; opacity:0; transition:opacity .3s ease;
  }
  .g-item:hover .g-cap{opacity:1;}
  .g-item[data-cat] {transition: opacity .3s ease, transform .3s ease;}
  .g-item.hide{display:none;}

  /* ===== REGISTRATION ===== */
  .registration{background:var(--cream);}
  .reg-grid{display:grid; grid-template-columns:1fr 1fr 1fr; gap:2px; background:var(--line); border:1px solid var(--line);}
  @media (max-width:760px){ .reg-grid{grid-template-columns:1fr;} }
  .reg-card{background:var(--white); padding:36px 32px;}
  .reg-card .r-icon{width:34px; height:34px; color:var(--brick); margin-bottom:18px;}
  .reg-card h4{font-size:16px; font-family:'Noto Sans Malayalam',sans-serif; font-weight:700; margin-bottom:8px;}
  .reg-card .val{font-family:'Fraunces',serif; font-size:19px; color:var(--ink); letter-spacing:0.03em;}
  .reg-card .sub{font-size:13.5px; color:var(--ink-soft); margin-top:6px;}

  /* ===== FINAL CTA ===== */
  .final-cta{
    position:relative; padding:150px 0; color:var(--white); text-align:left; overflow:hidden;
  }
  .final-cta img{position:absolute; inset:0; width:100%; height:100%; object-fit:cover;}
  .final-cta .overlay{position:absolute; inset:0; background:linear-gradient(120deg, rgba(20,16,13,0.94) 30%, rgba(90,40,20,0.72));}
  .final-cta .inner{position:relative; z-index:1; max-width:640px;}
  .final-cta h2{color:var(--white); font-size:clamp(30px,4.2vw,48px);}
  .final-cta p{margin-top:18px; color:var(--cream-2); font-size:17px; max-width:52ch;}
  .final-cta .hero-ctas{margin-top:36px;}

  /* ===== CONTACT ===== */
  .contact{background:var(--cream-2);}
